<% layout("/layouts/boilerplate") %>

<main class="listing-form-page">
    <a href="/listings" class="detail-back-link">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        All listings
    </a>
    <header class="listing-form-heading">
        <p class="detail-eyebrow">NEW STAY</p>
        <h1>Create a listing</h1>
    </header>

    <form method="POST" action="/listings" novalidate class="needs-validation listing-form">
        <input type="hidden" name="returnTo" value="/listings/new">
        <div class="mb-3">
            <label for="title" class="form-label">Listing title</label>
            <input type="text" id="title" name="listing[title]" placeholder="e.g. Ocean-view cottage" class="form-control" required>
            <div class="invalid-feedback">Please enter a title.</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea id="description" name="listing[description]" rows="5" placeholder="Describe the stay" class="form-control" required></textarea>
            <div class="invalid-feedback">Please enter a description.</div>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Image URL</label>
            <input type="url" id="image" name="listing[image][url]" placeholder="https://example.com/photo.jpg" class="form-control">
            <div class="invalid-feedback">Enter a valid image URL.</div>
        </div>
        <div class="row g-3">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price per night</label>
                <div class="input-group">
                    <span class="input-group-text">&#8377;</span>
                    <input type="number" id="price" name="listing[price]" min="0" step="1" placeholder="1200" class="form-control" required>
                    <div class="invalid-feedback">Enter a valid price.</div>
                </div>
            </div>
            <div class="mb-3 col-md-8">
                <label for="location" class="form-label">Location</label>
                <input type="text" id="location" name="listing[location]" placeholder="City or region" class="form-control" required>
                <div class="invalid-feedback">Please enter a location.</div>
            </div>
        </div>
        <div class="mb-3">
            <label for="country" class="form-label">Country</label>
            <input type="text" id="country" name="listing[country]" placeholder="Country" class="form-control" required>
            <div class="invalid-feedback">Please enter a country.</div>
        </div>
        <div class="listing-form-actions">
            <a href="/listings" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn add-btn">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                Create listing
            </button>
        </div>
    </form>
</main>